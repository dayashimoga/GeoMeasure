<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting up.
         This theme determines the color of the background shown before Flutter
         renders its first frame. After that, this theme continues to determine
         the Window background behind the Flutter UI. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the Flutter engine is
         ready to draw. The transition from LaunchTheme to NormalTheme is
         controlled by the Flutter framework. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:attr/windowBackground</item>
    </style>
</resources>
